---
import Base from "../layouts/Base.astro";
export const prerender = false;
---

<Base title="404 — Not Found">
  <main style="max-width: 600px; margin: 8rem auto; text-align: center; color: #fff;">
    <h1 style="font-size: 3rem; margin-bottom: 1rem;">404</h1>
    <p style="color: #a1a1aa; margin-bottom: 2rem;">Page not found.</p>
    <a href="/" style="color: #60a5fa; text-decoration: underline;">Return home</a>
  </main>
</Base>
