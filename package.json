{
  "name": "ve5p3r-dev-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bun and React migration of ve5p3r.dev.",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun run build && bun --no-env-file --hot src/server.ts",
    "build": "bun --no-env-file run scripts/build.ts",
    "start": "bun --cwd=dist --no-env-file run server.js",
    "test": "bun --no-env-file run scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write package.json tsconfig.json .oxlintrc.json .prettierrc.json project.code-workspace .vscode scripts src web",
    "format:check": "prettier --check package.json tsconfig.json .oxlintrc.json .prettierrc.json project.code-workspace .vscode scripts src web",
    "lint": "oxlint --deny-warnings src web scripts",
    "lint:fix": "oxlint --fix --deny-warnings src web scripts",
    "check:local": "bun --no-env-file run scripts/check.ts",
    "sandbox:prepare": "code-sbx prepare .",
    "sandbox:preflight": "code-sbx preflight .",
    "sandbox:agent": "code-sbx agent ."
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "oxlint": "1.86.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
