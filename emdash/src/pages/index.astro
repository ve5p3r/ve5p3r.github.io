---
import { getEmDashCollection, getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import { App, type HomepageContent } from "../components/App";

export const prerender = false;

async function loadHomepage(): Promise<HomepageContent | undefined> {
  try {
    const { entry } = await getEmDashEntry("homepage", "home-config");
    if (entry?.data) {
      return entry.data as unknown as HomepageContent;
    }
  } catch {
    // Graceful fallback to default values
  }

  try {
    const { entries } = await getEmDashCollection("homepage", { limit: 1 });
    if (entries && entries.length > 0 && entries[0]?.data) {
      return entries[0].data as unknown as HomepageContent;
    }
  } catch {
    // Graceful fallback
  }

  return undefined;
}

const cmsContent = await loadHomepage();
---

<Base>
  <App content={cmsContent} />
</Base>
