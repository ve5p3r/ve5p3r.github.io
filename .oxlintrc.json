{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "builtin": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/jsx-key": "error"
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "out/**", "coverage/**", ".cache/**"]
}
